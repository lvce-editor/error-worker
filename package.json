{
  "name": "@lvce-editor/error-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "npm run build:watch --workspace build",
    "dev": "node packages/build/src/dev.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "measure": "cd packages/memory && npm run measure",
    "test": "npm test --workspaces --if-present",
    "test-integration": "npm run test-integration --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.12.0",
    "eslint": "10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
